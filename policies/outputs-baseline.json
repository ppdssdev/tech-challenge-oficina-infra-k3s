{
  "account_id": {
    "description": [
      "string: conta configurada e restringida por allowed_account_ids no provider."
    ],
    "sensitive": [
      false
    ],
    "value": [
      "${tostring(var.aws_account_id)}"
    ]
  },
  "app_security_group_id": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_security_group.app.id}"
    ]
  },
  "auth_security_group_id": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_security_group.auth.id}"
    ]
  },
  "contract_version": {
    "description": [
      "number: vers\u00e3o do contrato de integra\u00e7\u00e3o."
    ],
    "sensitive": [
      false
    ],
    "value": [
      3
    ]
  },
  "environment": {
    "description": [
      "string: ambiente do contrato."
    ],
    "sensitive": [
      false
    ],
    "value": [
      "${tostring(var.environment)}"
    ]
  },
  "instance_id": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_instance.node.id}"
    ]
  },
  "instance_public_ip": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_instance.node.public_ip}"
    ]
  },
  "integration_contract": {
    "description": [
      "Contrato v3 n\u00e3o sens\u00edvel; publicar somente este objeto para infra-rds/auth."
    ],
    "sensitive": [
      false
    ],
    "value": [
      {
        "account_id": "${tostring(var.aws_account_id)}",
        "app_security_group_id": "${tostring(aws_security_group.app.id)}",
        "auth_security_group_id": "${tostring(aws_security_group.auth.id)}",
        "environment": "${tostring(var.environment)}",
        "private_subnet_ids": "${tolist([for key in sort(keys(aws_subnet.private)) : tostring(aws_subnet.private[key].id)])}",
        "region": "${tostring(var.aws_region)}",
        "schema_version": 3,
        "vpc_id": "${tostring(aws_vpc.this.id)}"
      }
    ]
  },
  "private_subnet_ids": {
    "description": [
      "list(string), AZ a/b ordenadas; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${tolist([for key in sort(keys(aws_subnet.private)) : aws_subnet.private[key].id])}"
    ]
  },
  "public_subnet_id": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_subnet.public.id}"
    ]
  },
  "region": {
    "description": [
      "string: regi\u00e3o do contrato."
    ],
    "sensitive": [
      false
    ],
    "value": [
      "${tostring(var.aws_region)}"
    ]
  },
  "secretsmanager_endpoint_id": {
    "description": [
      "ID n\u00e3o secreto para secrets_endpoint_id da stack auth; null quando desabilitado. Contrato v3 preservado."
    ],
    "sensitive": [
      false
    ],
    "value": [
      "${try(aws_vpc_endpoint.secretsmanager[\"enabled\"].id,None)}"
    ]
  },
  "vpc_id": {
    "description": [
      "string, refer\u00eancia n\u00e3o sens\u00edvel; dispon\u00edvel ap\u00f3s apply autorizado."
    ],
    "value": [
      "${aws_vpc.this.id}"
    ]
  }
}
